---
// A layout with no client-side router and no scripts: Astro sends plain HTML.
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Astro Steps Demo</title>
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>
